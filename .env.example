# Copier ce fichier en .env puis remplir les valeurs
DATABASE_URL=postgresql://association:association@localhost:5433/association
# Mettre true si votre hébergeur PostgreSQL exige SSL (Render, Neon, Supabase…)
DATABASE_SSL=false
# Longue chaîne aléatoire, ex. : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changez-moi
PORT=3000
